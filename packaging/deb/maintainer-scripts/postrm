#!/bin/sh
# Safety net: remove any of our symlinks the prerm hook may have missed.
# Self-contained, and only touches symlinks pointing into our services dir.
case "${1:-}" in
	remove|purge) ;;
	*) exit 0 ;;
esac

for p in \
	/etc/init.d/podman-healthcheckd \
	/etc/conf.d/podman-healthcheckd \
	/etc/sv/podman-healthcheckd \
	/etc/dinit.d/podman-healthcheckd
do
	[ -L "$p" ] || continue
	case "$(readlink "$p")" in
		/usr/share/podman-healthcheckd/services/*) rm -f "$p" ;;
	esac
done

exit 0
