# Maintainer: Franz Geffke <mail@gofranz.com>
pkgname=podman-healthcheckd
pkgver=0.1.4
pkgrel=0
pkgdesc="Podman healthcheck scheduler for systems without systemd"
url="https://github.com/franzos/podman-healthcheckd"
arch="x86_64"
license="MIT"
depends=""
makedepends=""
source=""
install="$pkgname.post-install $pkgname.pre-deinstall $pkgname.post-deinstall"
options="!check"

# The musl binary is built by CI and copied next to this APKBUILD, so this
# recipe only assembles the package instead of compiling from source.
build() {
	:
}

package() {
	install -Dm755 "$startdir/podman-healthcheckd" \
		"$pkgdir/usr/bin/podman-healthcheckd"

	# The service definitions stay under /usr/share and are symlinked into
	# place by detect-init.sh depending on the init system that is present
	# (see packaging/services/). They remain apk-owned files, so upgrades,
	# verification and removal work normally; only the symlink is created
	# at install time.
	install -Dm755 "$startdir/../scripts/detect-init.sh" \
		"$pkgdir/usr/share/podman-healthcheckd/detect-init.sh"
	cp -R "$startdir/../services" \
		"$pkgdir/usr/share/podman-healthcheckd/"
}
