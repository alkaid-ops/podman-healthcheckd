# Maintainer: Franz Geffke <mail@gofranz.com>
pkgname=podman-healthcheckd
pkgver=0.1.4
pkgrel=0
pkgdesc="Podman healthcheck scheduler for systems without systemd"
url="https://github.com/franzos/podman-healthcheckd"
arch="x86_64"
license="MIT"
depends=""
makedepends=""
source=""
subpackages="$pkgname-openrc"
options="!check"

# The musl binary is built by CI and copied next to this APKBUILD, so this
# recipe only assembles the package instead of compiling from source.
build() {
	:
}

package() {
	install -Dm755 "$startdir/podman-healthcheckd" \
		"$pkgdir/usr/bin/podman-healthcheckd"
	install -Dm755 "$startdir/podman-healthcheckd.openrc" \
		"$pkgdir/etc/init.d/podman-healthcheckd"
	install -Dm644 "$startdir/podman-healthcheckd.confd" \
		"$pkgdir/etc/conf.d/podman-healthcheckd"
}

openrc() {
	depends="$pkgname"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	amove etc/init.d/podman-healthcheckd etc/conf.d/podman-healthcheckd
}
