#!/bin/sh
### BEGIN INIT INFO
# Provides:          podman-healthcheckd
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Podman healthcheck scheduler
# Description:       Schedules Podman container healthchecks without systemd timers.
### END INIT INFO

NAME=podman-healthcheckd
DAEMON=/usr/bin/podman-healthcheckd
PIDFILE=/run/$NAME.pid
LOGFILE=/var/log/$NAME.log
export RUST_LOG="${RUST_LOG:-info}"

[ -x "$DAEMON" ] || exit 0

start() {
	echo "Starting $NAME"
	start-stop-daemon --start --quiet --background --make-pidfile \
		--pidfile "$PIDFILE" --exec "$DAEMON" -- >>"$LOGFILE" 2>&1
}

stop() {
	echo "Stopping $NAME"
	start-stop-daemon --stop --quiet --retry=TERM/30/KILL/5 --pidfile "$PIDFILE"
	rm -f "$PIDFILE"
}

status() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "$NAME is running"
		return 0
	fi
	echo "$NAME is not running"
	return 3
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart|force-reload)
		stop
		start
		;;
	status) status ;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 2
		;;
esac
